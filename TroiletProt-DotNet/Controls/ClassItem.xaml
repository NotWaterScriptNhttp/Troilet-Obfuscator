<local:ExclusionItemBase x:Class="TroiletProt_DotNet.Controls.ClassItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TroiletProt_DotNet.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="18" d:DesignWidth="200">
    <Grid>
        <TextBlock x:Name="itemname" Margin="37,-3,0,0" FontSize="16" Foreground="White" MouseEnter="itemname_MouseEnter" MouseLeave="itemname_MouseLeave" MouseUp="itemname_MouseUp"/>
        <Image x:Name="itemimage" Margin="19,0,0,0" HorizontalAlignment="Left" Width="16" Height="16"/>
        <CheckBox x:Name="itemexclude" HorizontalAlignment="Left" Margin="1,1.5,0,1.5"/>
    </Grid>
</local:ExclusionItemBase>
