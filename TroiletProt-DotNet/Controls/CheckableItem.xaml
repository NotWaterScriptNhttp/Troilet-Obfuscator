<UserControl x:Class="TroiletProt_DotNet.Controls.CheckableItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TroiletProt_DotNet.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="18" d:DesignWidth="200">
    <Grid>
        <TextBlock x:Name="itemname" Margin="36,0,0,0"/>
        <Image x:Name="itemimage" Margin="18,0,0,0" HorizontalAlignment="Left" Width="18"/>
        <CheckBox x:Name="itemexclude" HorizontalAlignment="Left" Margin="1,1,0,-3"/>

    </Grid>
</UserControl>
