<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TroiletGUI.Controls"
             xmlns:TroiletGUI="clr-namespace:TroiletGUI" x:Class="TroiletGUI.Controls.PluginItem"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="200">
    <Grid>
        <Label x:Name="pluginName" Content="Label" HorizontalAlignment="Center" VerticalAlignment="Top" Height="30" Width="200" FontWeight="Bold" FontSize="16" Foreground="White"/>
        <Label x:Name="pluginDescription" Content="Label" HorizontalAlignment="Center" Margin="0,26,0,0" VerticalAlignment="Top" Width="200" Foreground="White"/>
    </Grid>
</UserControl>
