<Page x:Class="TroiletGUI.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TroiletGUI.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="760" d:DesignWidth="650"
      Title="SettingsPage">

    <Grid>
        <ComboBox x:Name="ObfuscatorPicker" Margin="10,10,325,0" VerticalAlignment="Top" SelectionChanged="ObfuscatorPicker_SelectionChanged"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10,37,10,10">
            <StackPanel x:Name="settingItems" Orientation="Vertical" >
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
