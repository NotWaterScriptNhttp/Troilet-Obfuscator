<Page x:Class="TroiletGUI.Pages.FilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TroiletGUI.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="760" d:DesignWidth="650"
      Title="FilePage">

    <Grid>
        <TextBox x:Name="selectedFile" Margin="10,70,61,669" TextWrapping="Wrap" FontSize="14"/>
        <Button x:Name="pickFileBtn" Content="..." Margin="0,70,10,0" VerticalAlignment="Top" Click="pickFileBtn_Click" Height="{Binding Height, ElementName=selectedFile}" HorizontalAlignment="Right" Width="46"/>
        <Image x:Name="fileIcon" HorizontalAlignment="Left" Height="50" Margin="10,10,0,0" VerticalAlignment="Top" Width="50" Source="/Icon128.png"/>
        <Label x:Name="fileNameLbl" HorizontalAlignment="Left" Margin="70,10,0,0" VerticalAlignment="Top" Foreground="White" Content="Filename"/>
        <Label x:Name="fileSizeLbl" HorizontalAlignment="Left" Margin="70,39,0,0" VerticalAlignment="Top" Foreground="White" Content="Filesize: 0x0"/>
    </Grid>
</Page>
