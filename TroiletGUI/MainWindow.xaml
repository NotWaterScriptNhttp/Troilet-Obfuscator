<Window x:Name="window" x:Class="TroiletGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TroiletGUI"
        mc:Ignorable="d" 
        Height="800" Width="800" 
        Background="#FF1E1E1E" 
        WindowStartupLocation="CenterScreen" 
        BorderThickness="1,1,1,1" BorderBrush="White" 
        WindowStyle="None" 
        ResizeMode="CanResizeWithGrip" AllowsTransparency="True" 
        Title="Troilet" 
        Foreground="White"
        MinWidth="800" MinHeight="800" Icon="/Icon128.png" Activated="window_Activated" Deactivated="window_Deactivated">
    <Grid>
        <Grid x:Name="topbar" Margin="0,0,0,760" HorizontalAlignment="Center" Width="800" Height="40" Background="#FF2D2D2D" MouseDown="topbar_MouseDown">
            <Image x:Name="wndicon" HorizontalAlignment="Right" Height="40" VerticalAlignment="Top" Width="40" Margin="0,0,760,0" Source="{Binding Icon, ElementName=window}"/>
            <Label x:Name="wndtitle" VerticalContentAlignment="Center" Content="{Binding Title, ElementName=window}" Margin="40,0,0,2" Width="150" Height="40" Foreground="{Binding Foreground, ElementName=window}" HorizontalAlignment="Left" FontSize="16" FontWeight="Bold"/>

            <Label x:Name="settingsbtn" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Content="Settings" HorizontalAlignment="Left" Margin="682,0,0,0" VerticalAlignment="Center" Width="78" Height="40" FontSize="18" Foreground="{Binding Foreground, ElementName=window}"/>
            <Label x:Name="wndclosebtn" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Content="X" HorizontalAlignment="Left" Margin="760,0,0,0" VerticalAlignment="Center" Width="40" Height="40" FontSize="18" Foreground="{Binding Foreground, ElementName=window}"/>
        </Grid>
        <Grid x:Name="sidebar" Width="150" Margin="0,38,648,0" Background="#FF141414">
            <Button x:Name="sidefilebtn" Content="File" HorizontalAlignment="Left" VerticalAlignment="Top" Height="40" Width="151" Foreground="{Binding Foreground, ElementName=window}" BorderBrush="{Binding BorderBrush, ElementName=window}" Margin="-1,0,0,0" FontSize="16" Background="#00DDDDDD"/>
            <Button x:Name="sidepluginsbtn" Content="Plugins" HorizontalAlignment="Center" VerticalAlignment="Top" Height="40" Width="151" Foreground="{Binding Foreground, ElementName=window}" BorderBrush="{Binding BorderBrush, ElementName=window}" FontSize="16" Margin="-1,39,0,0" Background="#00DDDDDD"/>

        </Grid>
        <Frame x:Name="pageview" Margin="150,38,0,0" HorizontalAlignment="Left" Width="650" NavigationUIVisibility="Hidden"/>


    </Grid>
</Window>
